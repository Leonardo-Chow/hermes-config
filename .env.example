# 环境变量模板
# 复制此文件为 .env 并填入你的 API keys
# cp .env.example .env

# ══════════════════════════════════════════════════════════════
# AI 模型配置
# ══════════════════════════════════════════════════════════════

# 小米 MiMo API（必需）
XIAOMI_API_KEY=your_xiaomi_api_key_here

# ══════════════════════════════════════════════════════════════
# 搜索工具
# ══════════════════════════════════════════════════════════════

# Tavily Search API（推荐）
TAVILY_API_KEY=your_tavily_api_key_here

# ══════════════════════════════════════════════════════════════
# GitHub 集成
# ══════════════════════════════════════════════════════════════

# GitHub Personal Access Token（可选）
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# ══════════════════════════════════════════════════════════════
# 腾讯文档
# ══════════════════════════════════════════════════════════════

# 腾讯文档 API（可选）
TENCENT_DOC_API_KEY=your_tencent_doc_key_here

# ══════════════════════════════════════════════════════════════
# IMA 知识库
# ══════════════════════════════════════════════════════════════

# IMA API Key（可选）
IMA_API_KEY=your_ima_api_key_here
IMA_CLIENT_ID=your_ima_client_id_here

# ══════════════════════════════════════════════════════════════
# YouTube API
# ══════════════════════════════════════════════════════════════

# YouTube Data API Key（可选）
YOUTUBE_API_KEY=your_youtube_api_key_here

# ══════════════════════════════════════════════════════════════
# 其他可选配置
# ══════════════════════════════════════════════════════════════

# OpenRouter API（可选，用于模型路由）
OPENROUTER_API_KEY=your_openrouter_key_here

# ElevenLabs TTS（可选，语音合成）
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Spotify API（可选，音乐控制）
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ══════════════════════════════════════════════════════════════
# 代理配置（可选）
# ══════════════════════════════════════════════════════════════

# HTTP 代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# SOCKS5 代理
# ALL_PROXY=socks5://127.0.0.1:10808
